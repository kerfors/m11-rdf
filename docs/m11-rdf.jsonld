  {
    "@id": "https://w3id.org/m11-rdf/",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "Kerstin Forsberg"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "A derived rendering of the ICH M11 Technical Specification (Step 4, 2025-11-19), the ICH M11 code lists and OID Listing, and the ICH M11 Terminology published by NCI EVS (release 2025-12-19): one IRI per protocol element, section and code list; the headings and fields of the ICH M11 Template (Step 4, 2025-11-19), each linked to its section and to the element it realises. Mapping statements from the elements to USDM v4 attributes (usdm-rdf), as stated in the HL7 FHIR Clinical Study Protocol IG ballot mapping (May 2026) and the CDISC DDF-RA v4.0.0 M11 mapping, are published separately as an SSSOM mapping set (rdfs:seeAlso) that points at these identifiers. Draft, not normative. Not an ICH, CDISC or HL7 artifact, and not endorsed or sponsored by ICH."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/rights": [
      {
        "@language": "en",
        "@value": "Contains information derived from the ICH M11 Technical Specification, the ICH M11 Template and the ICH M11 code lists and OID Listing, copyright ICH, used under the ICH Legal Mentions (https://www.ich.org/page/legal-mentions); changes made: rendered as RDF and joined with the EVS terminology; of the Template, headings and fields rendered as RDF and linked to the elements, instructional and universal text not carried. Contains terms and definitions from the ICH M11 Terminology, NCI Enterprise Vocabulary Services, CC BY 4.0."
      }
    ],
    "http://purl.org/dc/terms/source": [
