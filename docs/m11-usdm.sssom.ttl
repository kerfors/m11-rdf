@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ddfra: <https://raw.githubusercontent.com/cdisc-org/DDF-RA/v4.0.0/Documents/Mappings/> .
@prefix hl7csp: <https://hl7.org/fhir/uv/clinical-study-protocol/2026May/en/Mappings/> .
@prefix m11: <https://w3id.org/m11-rdf/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sssom: <https://w3id.org/sssom/> .
@prefix usdm: <https://w3id.org/cdisc/usdm/v4/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

m11:m11-usdm.sssom.tsv a sssom:MappingSet ;
    dcterms:description "One record per row of the HL7 FHIR Clinical Study Protocol IG ballot mapping (May 2026) and of the CDISC DDF-RA v4.0.0 M11 mapping whose M11 side is identified against m11-rdf and whose USDM target resolves in usdm-rdf (USDM v4.0.0). Neither mapping is primary. The link from element to USDM target is the publisher's; m11-rdf adds only the identification of the M11 side: by code (the row's NCIt Code is the concept of one element, or the row's section decides between namespaces), or by the row's element name when its normalised form (case, punctuation, brackets, white space) equals the term of exactly one Technical Specification element block. Target and condition paths as given, line breaks replaced by a space. Rows without a record are listed in reports/d2-residue.csv. Draft, not normative; not an ICH, CDISC or HL7 artifact." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "ICH M11 elements to USDM v4 (usdm-rdf), as stated in two published mappings" ;
    rdfs:seeAlso <https://github.com/kerfors/m11-rdf> ;
    owl:versionInfo "0.3.0" ;
    sssom:creator_label "Kerstin Forsberg" ;
    sssom:extension_definitions [ a sssom:ExtensionDefinition ;
            sssom:property m11:sourceRow ;
            sssom:slot_name "source_row" ;
            sssom:type_hint xsd:integer ],
        [ a sssom:ExtensionDefinition ;
            sssom:property m11:sourceSection ;
            sssom:slot_name "source_section" ;
            sssom:type_hint xsd:string ],
        [ a sssom:ExtensionDefinition ;
            sssom:property m11:subjectIdentification ;
            sssom:slot_name "subject_identification" ;
            sssom:type_hint xsd:string ],
        [ a sssom:ExtensionDefinition ;
            sssom:property m11:objectResolution ;
            sssom:slot_name "object_resolution" ;
            sssom:type_hint xsd:string ],
        [ a sssom:ExtensionDefinition ;
            sssom:property m11:statedClass ;
            sssom:slot_name "stated_class" ;
            sssom:type_hint xsd:string ],
        [ a sssom:ExtensionDefinition ;
            sssom:property m11:statedAttribute ;
            sssom:slot_name "stated_attribute" ;
            sssom:type_hint xsd:string ],
        [ a sssom:ExtensionDefinition ;
            sssom:property m11:targetPath ;
            sssom:slot_name "target_path" ;
            sssom:type_hint xsd:string ],
        [ a sssom:ExtensionDefinition ;
            sssom:property m11:conditionPath ;
            sssom:slot_name "condition_path" ;
            sssom:type_hint xsd:string ] ;
    sssom:mappings <https://w3id.org/m11-rdf/mapping/cdisc/104>,
