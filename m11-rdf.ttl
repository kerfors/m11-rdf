    m11:hasSpecification [ a m11:Specification ;
            m11:cardinality "One to one" ;
            m11:conformance "Required" ;
            m11:dataType "Table; Text; Image" ;
            m11:dvh "D" ;
            m11:hasConformanceCategory m11:Required ;
            m11:inSection m11:C217272.C218519 ;
            m11:repeatReuse "Yes, repeatable for each Schedule of Activity if needed" ;
            m11:tocReference "1.3" ;
            m11:tsBlock 160 ;
            m11:tsTerm "<Schedule of Activities>" ] ;
    m11:ichConceptCode "C132349" ;
    m11:ichNamespaceOid "2.16.840.1.113883.3.989.2.3.3.1"^^m11:ichOid ;
    m11:labelSource m11:EVSTerminology ;
    m11:pairBasis m11:StatedInTS .

