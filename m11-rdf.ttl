            m11:cardinality "One to one" ;
            m11:conformance "Conditional: when any background interventions are defined" ;
            m11:dataType "Text" ;
            m11:dvh "D" ;
            m11:hasConformanceCategory m11:Conditional ;
            m11:inSection m11:C217272.C218577 ;
            m11:repeatReuse "No" ;
            m11:tocReference "6.9.1" ;
            m11:tsBlock 346 ;
            m11:tsTerm "{<Background Trial Intervention>}" ] ;
    m11:ichConceptCode "C222329" ;
    m11:ichNamespaceOid "2.16.840.1.113883.3.989.2.3.3.6"^^m11:ichOid ;
    m11:labelSource m11:EVSTerminology ;
    m11:pairBasis m11:DerivedFromSection .

