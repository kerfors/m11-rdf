m11:C217344.C49236 a m11:Element ;
    skos:definition "The treatment condition of interest and, as appropriate, the alternative treatment condition to which comparison will be made (referred to as \"treatment\" through the remainder of this document). These might be individual interventions, combinations of interventions administered concurrently, e.g. as add-on to standard of care, or might consist of an overall regimen involving a complex sequence of interventions."@en ;
    skos:exactMatch evs:C217344.C49236 ;
    skos:inScheme m11:C217344 ;
    skos:prefLabel "Treatment"@en ;
    m11:concept ncit:C49236,
        obo:NCIT_C49236 ;
    m11:hasSpecification [ a m11:Specification ;
            m11:cardinality "One to Row Heading; One to Primary Objective Table; Project Identifier" ;
            m11:conformance "Conditional: If there is a treatment as estimand characteristic" ;
            m11:dataType "Text" ;
            m11:dvh "D" ;
            m11:hasConformanceCategory m11:Conditional ;
            m11:inSection m11:C217272.C218527 ;
            m11:repeatPattern "3.1.X where X is a unique number for each Primary Objective" ;
            m11:repeatReuse "Yes, repeatable for each numbered Primary Objective" ;
            m11:tocReference "3.1.X where X is a unique number for each Primary Objective" ;
            m11:tsBlock 182 ;
            m11:tsTerm "{<Treatment>}" ],
        [ a m11:Specification ;
            m11:cardinality "One to Row Heading, One to Secondary Objective Table, Project Identifier" ;
            m11:conformance "Conditional: If there is a population for Secondary" ;
            m11:dataType "Text" ;
            m11:dvh "D" ;
            m11:hasConformanceCategory m11:Conditional ;
            m11:inSection m11:C217272.C218529 ;
            m11:repeatPattern "3.2.X where X is a unique number for each Secondary Objective" ;
            m11:repeatReuse "Yes, repeatable for each numbered Secondary Objective." ;
            m11:tocReference "3.2.X where X is a unique number for each Secondary Objective" ;
            m11:tsBlock 200 ;
            m11:tsTerm "{<Treatment>}" ],
        [ a m11:Specification ;
            m11:cardinality "One to Row Heading; One to Exploratory Objective Table; Project Identifier" ;
            m11:conformance "Conditional: If there is a treatment as estimand" ;
            m11:dataType "Text" ;
            m11:dvh "D" ;
            m11:hasConformanceCategory m11:Conditional ;
            m11:inSection m11:C217272.C218531 ;
            m11:repeatPattern "3.3.X where X is a unique number for each Exploratory Objective" ;
            m11:repeatReuse "Yes, repeatable for each numbered Exploratory Objective." ;
            m11:tocReference "3.3.X where X is a unique number for each Exploratory Objective" ;
            m11:tsBlock 218 ;
            m11:tsTerm "{<Treatment>}" ] ;
    m11:ichConceptCode "C49236" ;
    m11:ichNamespaceOid "2.16.840.1.113883.3.989.2.3.3.3"^^m11:ichOid ;
    m11:labelSource m11:EVSTerminology ;
    m11:mappedTo usdm:AdministrableProduct-label,
        usdm:Administration-frequency,
        usdm:Administration-route,
        usdm:StudyIntervention-label ;
    m11:pairBasis m11:StatedInTS .

