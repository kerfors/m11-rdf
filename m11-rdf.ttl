            m11:cardinality "One to one" ;
            m11:conformance "Required" ;
            m11:dataType "Valid Value" ;
            m11:dvh "V" ;
            m11:hasConformanceCategory m11:Required ;
            m11:hasValueCodeList m11:C217274 ;
            m11:inSection m11:C217272.C218669 ;
            m11:repeatReuse "No" ;
            m11:statedCodeListOid "2.16.840.1.113883.3.989.2.3.1.1"^^m11:ichOid ;
