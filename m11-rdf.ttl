m11:C217350.C218790 a m11:Element ;
    skos:definition "A description of alternative techniques by which trial related events, such as adverse events, serious adverse events, product complaints, medical device product complaints, and pregnancy and postpartum events, are reported to the sponsor and/or regulatory authority."@en ;
    skos:exactMatch evs:C217350.C218790 ;
    skos:inScheme m11:C217350 ;
    skos:prefLabel "Back-up Method for Reporting"@en ;
    m11:concept ncit:C218790,
        obo:NCIT_C218790 ;
    m11:hasSpecification [ a m11:Specification ;
            m11:cardinality "One to one" ;
            m11:conformance "Optional if table is used" ;
            m11:dataType "Text" ;
            m11:dvh "D" ;
            m11:hasConformanceCategory m11:Optional ;
            m11:inSection m11:C217272.C218614 ;
            m11:repeatReuse "Yes, repeatable for each Event Type, Situational Scope, and Reportable Period Start." ;
            m11:tocReference "9.2" ;
            m11:tsBlock 430 ;
            m11:tsTerm "<Back-up Method for Reporting>" ] ;
    m11:ichConceptCode "C218790" ;
    m11:ichNamespaceOid "2.16.840.1.113883.3.989.2.3.3.9"^^m11:ichOid ;
    m11:labelSource m11:EVSTerminology ;
    m11:pairBasis m11:StatedInTS .

m11:C217350.C222263 a m11:Element ;
