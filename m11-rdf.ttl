            m11:cardinality "One to one; One to Amendment Identifier; One to Sponsor Protocol Identifier" ;
            m11:conformance "Conditional: if there is an amendment" ;
            m11:dataType "Valid Value" ;
            m11:dvh "V" ;
            m11:hasConformanceCategory m11:Conditional ;
            m11:hasValueCodeList m11:C217046 ;
            m11:inSection m11:C217272.C222770 ;
            m11:repeatReuse "No" ;
            m11:statedCodeListOid "2.16.840.1.113883.3.989.2.3.1.11"^^m11:ichOid ;
            m11:tocReference "Amendment Details" ;
            m11:tsBlock 78 ;
            m11:tsTerm "{[Yes/No]}" ] ;
    m11:ichConceptCode "C218700" ;
    m11:ichNamespaceOid "2.16.840.1.113883.3.989.2.3.3.15"^^m11:ichOid ;
    m11:labelSource m11:EVSTerminology ;
    m11:pairBasis m11:StatedInTS .

m11:C217357.C218701 a m11:Element ;
    skos:definition "A short descriptive account of any substantial impacts on the reliability and robustness of the data generated in the clinical trial due to the protocol amendment."@en ;
    skos:exactMatch evs:C217357.C218701 ;
    skos:inScheme m11:C217357 ;
    skos:prefLabel "Briefly Explain Substantial Impact on Data"@en ;
    m11:concept ncit:C218701,
        obo:NCIT_C218701 ;
    m11:hasSpecification [ a m11:Specification ;
            m11:cardinality "One to amendment identifier" ;
            m11:conformance "Conditional: if there is an amendment and if the answer to \"Is this amendment likely to have a substantial impact on the reliability and robustness of the data generated in the clinical trial?\" is Yes" ;
            m11:dataType "Text" ;
            m11:dvh "D" ;
            m11:hasConformanceCategory m11:Conditional ;
            m11:inSection m11:C217272.C222770 ;
            m11:repeatReuse "No" ;
            m11:tocReference "Amendment Details" ;
            m11:tsBlock 79 ;
            m11:tsTerm "{<If yes, briefly explain>}" ] ;
    m11:ichConceptCode "C218701" ;
    m11:ichNamespaceOid "2.16.840.1.113883.3.989.2.3.3.15"^^m11:ichOid ;
    m11:labelSource m11:EVSTerminology ;
    m11:pairBasis m11:StatedInTS .

m11:DerivedFromSection a m11:Basis ;
    rdfs:label "derived from the ToC section"@en ;
    rdfs:comment "The Technical Specification gives the concept without an OID; the namespace is the one whose section contains the element's ToC section."@en .

