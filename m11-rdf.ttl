m11:C217342 a m11:Namespace ;
    skos:definition "Terminology relevant to the data elements in section 1 of the ICH M11 protocol template."@en ;
    skos:exactMatch evs:C217342 ;
    skos:notation "2.16.840.1.113883.3.989.2.3.3.1"^^m11:ichOid ;
    skos:prefLabel "ICH M11 Section 1 Terminology"@en ;
    m11:concept ncit:C217342,
        obo:NCIT_C217342 ;
    m11:forSection m11:C217272.C218514 .

m11:C217356 a m11:Namespace ;
    skos:definition "Terminology relevant to the data elements in the title page of the ICH M11 protocol template."@en ;
    skos:exactMatch evs:C217356 ;
    skos:notation "2.16.840.1.113883.3.989.2.3.3.16"^^m11:ichOid ;
    skos:prefLabel "ICH M11 Section Title Page Terminology"@en ;
    m11:concept ncit:C217356,
        obo:NCIT_C217356 ;
    m11:forSection m11:C217272.C222769 .

m11:ControlledTerminology a m11:TemplateFieldKind ;
    rdfs:label "controlled terminology"@en ;
    rdfs:comment "[Square brackets]: a value picked from controlled terminology (Template section 0.3)."@en .

m11:Optional a m11:ConformanceCategory ;
    rdfs:label "Optional"@en .

m11:Conditional a m11:ConformanceCategory ;
    rdfs:label "Conditional"@en .

m11:Required a m11:ConformanceCategory ;
    rdfs:label "Required"@en .

m11:C217272 a m11:ValueCodeList ;
    skos:definition "A valid value set relevant to the protocol section name and number responses within the ICH M11 protocol template."@en ;
    skos:exactMatch evs:C217272 ;
    skos:notation "2.16.840.1.113883.3.989.2.3.1.13"^^m11:ichOid ;
    skos:prefLabel "Protocol Section Name and Number Response Terminology"@en ;
    m11:concept ncit:C217272,
        obo:NCIT_C217272 .

m11:Section a owl:Class ;
    rdfs:label "Section"@en ;
    rdfs:comment "A section of the ICH M11 protocol, identified by its term in code list C217272 (Protocol Section Name and Number). Local name C217272.<term code>."@en ;
    rdfs:subClassOf skos:Concept .

m11:ichConceptCode a owl:DatatypeProperty ;
    rdfs:label "ICH concept code"@en ;
    rdfs:domain m11:Element .

m11:TextInsertion a m11:TemplateFieldKind ;
    rdfs:label "text insertion point"@en ;
    rdfs:comment "<Chevrons>: where to insert text (Template section 0.3)."@en .

m11:EVSTerminology a m11:Basis ;
    rdfs:label "ICH M11 Terminology, NCI EVS, release 2025-12-19"@en .

m11:StatedInTS a m11:Basis ;
    rdfs:label "stated in the Technical Specification"@en .

m11:Element a owl:Class ;
    rdfs:label "Element"@en ;
    rdfs:comment "An ICH M11 protocol element: a concept within a namespace, identified by the (namespace code list, concept C-code) pair the Technical Specification states. Local name <namespace code list>.<concept code>."@en ;
    rdfs:subClassOf skos:Concept .

m11:TemplateField a owl:Class ;
    rdfs:label "Template field"@en ;
    rdfs:comment "A text insertion point (<...>) or controlled-terminology pick ([...]) in one section of the ICH M11 Template (Step 4, 2025-11-19), outside instructional text. A blank node on its section, not identified by an IRI."@en .

m11:tsTerm a owl:DatatypeProperty ;
    rdfs:label "TS term"@en ;
    rdfs:comment "The Term (Variable) field, verbatim."@en ;
    rdfs:domain m11:Specification .

m11:Specification a owl:Class ;
    rdfs:label "Specification"@en ;
    rdfs:comment "What one component block of Technical Specification Appendix 1 states about an element: place, conformance, cardinality, data type, value code list. An element specified in several blocks has several specifications; a block with alternative concepts is one specification shared by those elements."@en .

m11:mappedTo a owl:AnnotationProperty ;
    rdfs:label "mapped to"@en ;
    rdfs:comment "A published mapping row states that values of this ICH M11 element are held at this USDM attribute (a usdm-rdf property), under the target path and condition the row gives. The link is the mapping publisher's; m11-rdf identifies the M11 side of the row. An annotation property, so that an element can point at an OWL property without punning."@en ;
    rdfs:domain m11:Element .

_:spec145 a m11:Specification ;
    m11:cardinality "One to one" ;
    m11:conformance "Conditional: when Planned Duration of trial Intervention Number and unit of time" ;
    m11:dataType "Integer, Valid value" ;
    m11:dvh "D, V" ;
    m11:hasConformanceCategory m11:Conditional ;
    m11:hasValueCodeList m11:C217048 ;
    m11:inSection m11:C217272.C218517 ;
    m11:repeatReuse "No" ;
    m11:statedCodeListOid "2.16.840.1.113883.3.989.2.3.1.23"^^m11:ichOid ;
    m11:tocReference "1.1.2" ;
    m11:tsBlock 145 ;
    m11:tsTerm "{<total planned duration of trial intervention> [total planned duration of trial unit of time]}" .

_:spec148 a m11:Specification ;
    m11:cardinality "One to one" ;
    m11:conformance "Conditional: when planned duration of trial participation number and unit of time" ;
    m11:dataType "Integer, Valid value" ;
    m11:dvh "D, V" ;
    m11:hasConformanceCategory m11:Conditional ;
    m11:hasValueCodeList m11:C217048 ;
    m11:inSection m11:C217272.C218517 ;
    m11:repeatReuse "No" ;
    m11:statedCodeListOid "2.16.840.1.113883.3.989.2.3.1.23"^^m11:ichOid ;
    m11:tocReference "1.1.2" ;
    m11:tsBlock 148 ;
    m11:tsTerm "{<total planned duration of trial participation> [Total planned duration of trial participation unit of time]}" .

_:spec51 a m11:Specification ;
    m11:cardinality "One to one; One to Protocol Identifier; One to Original Protocol One to Amendment Identifier" ;
    m11:conformance "Required" ;
    m11:dataType "Date or Text" ;
    m11:dvh "V" ;
