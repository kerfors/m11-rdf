            m11:tocReference "9.2" ;
            m11:tsBlock 418 ;
            m11:tsTerm "<Other Event Type>" ] ;
    m11:ichConceptCode "C222263" ;
    m11:ichNamespaceOid "2.16.840.1.113883.3.989.2.3.3.9"^^m11:ichOid ;
