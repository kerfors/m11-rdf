m11:C217357.C218698 a m11:Element ;
    skos:definition "An indication as to whether the amendment is likely to have a substantial impact on the safety or rights of the participants."@en ;
    skos:exactMatch evs:C217357.C218698 ;
    skos:inScheme m11:C217357 ;
    skos:prefLabel "Is this amendment likely to have a substantial impact on the safety or rights of the participants?"@en ;
    m11:concept ncit:C218698,
        obo:NCIT_C218698 ;
    m11:hasSpecification [ a m11:Specification ;
            m11:cardinality "One to one; One to Amendment Identifier; One to Sponsor Protocol Identifier" ;
            m11:conformance "Conditional If there is an amendment" ;
            m11:dataType "Valid Value" ;
            m11:dvh "V" ;
            m11:hasConformanceCategory m11:Conditional ;
            m11:hasValueCodeList m11:C217046 ;
            m11:inSection m11:C217272.C222770 ;
            m11:repeatReuse "No" ;
            m11:statedCodeListOid "2.16.840.1.113883.3.989.2.3.1.11"^^m11:ichOid ;
            m11:tocReference "Amendment Details" ;
            m11:tsBlock 75 ;
            m11:tsTerm "{[Yes/No]}" ] ;
    m11:ichConceptCode "C218698" ;
    m11:ichNamespaceOid "2.16.840.1.113883.3.989.2.3.3.15"^^m11:ichOid ;
    m11:labelSource m11:EVSTerminology ;
    m11:pairBasis m11:StatedInTS .

m11:C217357.C218699 a m11:Element ;
    skos:definition "A short descriptive account of any substantial impacts on the safety or rights of the participants due to the protocol amendment."@en ;
    skos:exactMatch evs:C217357.C218699 ;
    skos:inScheme m11:C217357 ;
    skos:prefLabel "Briefly Explain Substantial Impact On Safety"@en ;
    m11:concept ncit:C218699,
        obo:NCIT_C218699 ;
    m11:hasSpecification [ a m11:Specification ;
            m11:cardinality "One to one Amendment Identifier, Is this amendment likely to have a substantial impact on the safety or rights of the participants? Response when Yes" ;
            m11:conformance "Conditional: if there is an amendment and if \"Is this amendment likely to have a substantial impact on the safety or rights of the participants? \" is Yes" ;
            m11:dataType "Text" ;
            m11:dvh "D" ;
            m11:hasConformanceCategory m11:Conditional ;
            m11:inSection m11:C217272.C222770 ;
            m11:repeatReuse "No" ;
            m11:tocReference "Amendment Details" ;
            m11:tsBlock 76 ;
            m11:tsTerm "{<If yes, briefly explain>}" ] ;
    m11:ichConceptCode "C218699" ;
    m11:ichNamespaceOid "2.16.840.1.113883.3.989.2.3.3.15"^^m11:ichOid ;
    m11:labelSource m11:EVSTerminology ;
    m11:pairBasis m11:StatedInTS .

m11:C217357.C218700 a m11:Element ;
    skos:definition "An indication as to whether the amendment likely to have a substantial impact on the reliability and robustness of the data generated in the clinical trial."@en ;
    skos:exactMatch evs:C217357.C218700 ;
    skos:inScheme m11:C217357 ;
    skos:prefLabel "Is this amendment likely to have a substantial impact on the reliability and robustness of the data generated in the clinical trial?"@en ;
