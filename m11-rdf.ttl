            m11:realises m11:C217351.C218481 ;
            m11:templateConditional true ;
            m11:templateOptional false ;
            m11:templateOrder 233 ;
            m11:templatePage 57 ;
            m11:templateSectionNumber "10.5.1.5" ] ;
    m11:headingElement m11:C217351.C218481 ;
    m11:placeScope "section" ;
    m11:sectionNumber "10.5.1.5" ;
    m11:templateConditional true ;
    m11:templateHeading "{Supplementary Analysis}" ;
    m11:templateOptional false ;
