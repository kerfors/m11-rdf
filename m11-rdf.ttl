m11:C217342.C132349 a m11:Element ;
    skos:definition "A standardised representation of planned clinical trial activities including interventions (e.g., administering drug, surgery) and study administrative activities (e.g., obtaining informed consent, distributing clinical trial material and diaries, randomisation) as well as assessments."@en ;
    skos:exactMatch evs:C217342.C132349 ;
    skos:inScheme m11:C217342 ;
    skos:prefLabel "Schedule of Activities"@en ;
    m11:concept ncit:C132349,
