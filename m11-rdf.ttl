    m11:labelSource m11:EVSTerminology ;
    m11:pairBasis m11:StatedInTS .

m11:C217353.C220640 a m11:Element ;
    skos:definition "Extra or supplementary appendices added to the end of a document."@en ;
    skos:exactMatch evs:C217353.C220640 ;
